#define ZMK_POINTING_DEFAULT_SCRL_VAL 300
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define FN 2
// #define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    // conditional_layers {
    //     compatible = "zmk,conditional-layers";

    //     adjust_layer {
    //         if-layers = <LOWER RAISE>;
    //         then-layer = <ADJUST>;
    //     };
    // };
	
	behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
			tap-ms = <20>;
        };

        bt_cycle: bt_cycle {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_PRV>, <&bt BT_NXT>;
			tap-ms = <20>;
        };

        comm_dlr: comma_dollar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOLLAR>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        dot: dot_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DOT>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        slsh_bsls: slash_back_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        exlm_circ: exclamation_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp CARET>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        ampr_pipe: ampersand_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp PIPE>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        ques_at: question_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp AT>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        hash_astr: hash_asterisk {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp ASTERISK>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

//         // Any mod combination: persist all mods but send 1 instead of brace
//         // Could mess with binding e.g. ctrl+shift+1 could be interpreted at ctrl+! or logically as ctrl+shift+{
//         one_lcbr: one_left_brace {
//             compatible = "zmk,behavior-mod-morph";
//             #binding-cells = <0>;
//             bindings = <&kp LBRC>, <&kp N1>;
//             mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
//             keep-mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
//         };
// 
//         // Shift only: send 1 alone
//         one_lcbr: one_left_brace {
//             compatible = "zmk,behavior-mod-morph";
//             #binding-cells = <0>;
//             bindings = <&kp LBRC>, <&kp N1>;
//             mods = <(MOD_LSFT)>;
//         };
        
        // Any mods: remove shift and replace with 1
        one_lcbr: one_left_brace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp N1>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        two_rcbr: two_right_brace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBRC>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        thre_labk: three_left_angle {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp N3>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        four_rabk: four_right_angle {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp GT>, <&kp N4>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        // five_none: five_none {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&kp MINUS>, <&kp N5>;
        //     mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        //     keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        // };

        six_perc: six_percent {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PRCNT>, <&kp N6>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        seven_lbrc: seven_left_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N7>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        eigh_rbrc: eight_right_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp N8>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        nine_lprn: nine_left_parentheses {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp N9>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
        
        zero_lprn: zero_right_parentheses {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp N0>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // PRINT_SCREEN, CALC

            bindings = <
&kp ESC     &kp LBRC    &kp RBRC    &kp LT      &kp GT      &kp N5                              &kp PRCNT   &kp LBKT    &kp RBKT    &kp LPAR    &kp RPAR    &sl FN
&kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T                               &kp Y       &kp U       &kp I       &kp O       &kp P       &hash_astr
&kp LGUI    &kp A       &kp S       &kp D       &kp F       &kp G                               &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&kp GRAVE   &kp Z       &kp X       &kp C       &kp V       &kp B                               &kp N       &kp M       &comm_dlr   &dot        &slsh_bsls  &ampr_pipe
&none                   &kp MINUS   &kp EQUAL   &kp LSHIFT  &kp BSPC    &kp LCTRL   &kp DEL     &kp SPACE   &kp ENTER   &exlm_circ  &ques_at

                                                                                    &tog NAV     &kp RIGHT   &kp UP      &kp LEFT    &kp DOWN
            >;

            sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
        };
        
        navigation_layer {
            label = "navigate";
            
            bindings = <
&trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&bt BT_CLR              &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans

                                                                                    &trans      &kp END     &kp PG_UP   &kp HOME    &kp PG_DN
            >;

            sensor-bindings = <&bt_cycle &inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            label = "function";
            
            bindings = <
&studio_unlock &kp F1   &kp F2      &kp F3      &kp F4      &kp F5                              &kp F8      &kp F9      &kp F10     &kp F11     &kp F12     &trans
&trans      &trans      &kp C_PP    &trans      &trans      &kp F6                              &kp F7      &trans      &trans      &trans      &trans      &trans
&trans      &kp C_PREV  &kp C_STOP  &kp C_NEXT  &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&kp C_MUTE              &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans

                                                                                    &trans    &trans      &trans      &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

//         bluetooth_layer {
